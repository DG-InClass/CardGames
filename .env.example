# Server-only credentials from the Upstash Redis integration in Vercel.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=
# Use different namespaces for production, previews, and local development.
CARD_TABLE_NAMESPACE=local
# Random secret used to authorize /api/gofish-cleanup (Vercel sends it automatically).
CRON_SECRET=
